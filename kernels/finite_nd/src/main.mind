// Author: STARGA Inc.
// CLI result is candidate-kernel acceptance, not project formal acceptance.
import kernel;
fn nd_emit(s: String) -> i64 {
    let mut pos: i64 = 0;
    while pos < s.len {
        let written: i64 = __mind_write(1, s.addr + pos, s.len - pos, 0 - 1);
        if written <= 0 { return 0; } pos = pos + written;
    }
    return 1;
}
fn main() -> i64 {
    let input: i64 = __mind_alloc(65537);
    let work: i64 = __mind_alloc(65536);
    if input == 0 || work == 0 { return 2; }
    let mut n: i64 = 0; let mut ended: i64 = 0;
    while n < 65536 && ended == 0 {
        let got: i64 = __mind_read(0, input + n, 65536 - n, 0 - 1);
        if got < 0 { __mind_free(input); __mind_free(work); return 2; }
        if got == 0 { ended = 1; } else { n = n + got; }
    }
    if ended == 0 {
        let extra: i64 = __mind_read(0, input + 65536, 1, 0 - 1);
        if extra < 0 { __mind_free(input); __mind_free(work); return 2; }
        if extra != 0 {
            __mind_free(input); __mind_free(work);
            if nd_emit("KERNEL_CHECK=FAIL\n") != 1 { return 2; } return 1;
        }
    }
    let accepted: i64 = finite_nd_check(input, n, work, 65536);
    __mind_free(input); __mind_free(work);
    if accepted == 1 {
        if nd_emit("KERNEL_CHECK=PASS\n") != 1 { return 2; } return 0;
    }
    if nd_emit("KERNEL_CHECK=FAIL\n") != 1 { return 2; } return 1;
}
