// Author: STARGA Inc.
// Candidate bounded natural-deduction checker, not an accepted proof authority.
// Integers in the semantics are unbounded. The ground evaluator implements a
// nonnegative fragment and refuses values outside 12 base-1000 limbs.
// Caller-owned input and workspace; no certificate-supplied address is used.
// Workspace: header128, terms10240, formulas20480, values24576, proofs8192,
// assumption stack240, multiplication temporary192. Total64048 <=65536.
fn nd_term(w: i64, i: i64) -> i64 { return w + 128 + (i - 1) * 40; }
fn nd_formula(w: i64, i: i64) -> i64 { return w + 10368 + (i - 1) * 40; }
fn nd_value(w: i64, i: i64) -> i64 { return w + 30848 + (i - 1) * 96; }
fn nd_line(w: i64, i: i64) -> i64 { return w + 55424 + (i - 1) * 32; }
fn nd_max(a: i64, b: i64) -> i64 { if a > b { return a; } return b; }

// Header fields: input0, length8, cursor16, error24, comparison budget32,
// term count40, formula count48, active assumptions56, stack depth64,
// next monotonic assumption ID72. All counters are bounded before use.
fn nd_number(w: i64) -> i64 {
    if __mind_load_i64(w + 24) != 0 { return 0 - 1; }
    let p: i64 = __mind_load_i64(w);
    let n: i64 = __mind_load_i64(w + 8);
    let first: i64 = __mind_load_i64(w + 16);
    let mut pos: i64 = first; let mut value: i64 = 0;
    while pos < n {
        let ch: i64 = __mind_load_i8(p + pos);
        if ch == 10 {
            if pos == first { __mind_store_i64(w + 24, 1); return 0 - 1; }
            __mind_store_i64(w + 16, pos + 1); return value;
        }
        if ch < 48 || ch > 57 {
            __mind_store_i64(w + 24, 1); return 0 - 1;
        }
        if pos > first && __mind_load_i8(p + first) == 48 {
            __mind_store_i64(w + 24, 1); return 0 - 1;
        }
        let digit: i64 = ch - 48;
        if value > 99999 {
            __mind_store_i64(w + 24, 1); return 0 - 1;
        }
        value = value * 10 + digit; pos = pos + 1;
    }
    __mind_store_i64(w + 24, 1); return 0 - 1;
}

fn nd_zero(p: i64, count: i64) -> i64 {
    let mut i: i64 = 0;
    while i < count { __mind_store_i64(p + i * 8, 0); i = i + 1; }
    return 1;
}
fn nd_add(x: i64, y: i64, out: i64) -> i64 {
    let mut i: i64 = 0; let mut carry: i64 = 0;
    while i < 12 {
        let a: i64 = __mind_load_i64(x + i * 8);
        let b: i64 = __mind_load_i64(y + i * 8);
        if a < 0 || a > 999 || b < 0 || b > 999 { return 0; }
        if carry < 0 || carry > 1 { return 0; }
        // At most 999+999+1=1999: exact in signed i64.
        let v: i64 = a + b + carry;
        __mind_store_i64(out + i * 8, v % 1000);
        carry = v / 1000; i = i + 1;
    }
    if carry != 0 { return 0; } return 1;
}
fn nd_multiply(w: i64, x: i64, y: i64, out: i64) -> i64 {
    let temp: i64 = w + 63856; nd_zero(temp, 24);
    let mut i: i64 = 0;
    while i < 12 {
        let a: i64 = __mind_load_i64(x + i * 8);
        if a < 0 || a > 999 { return 0; }
        let mut j: i64 = 0; let mut carry: i64 = 0;
        while j < 12 {
            let b: i64 = __mind_load_i64(y + j * 8);
            let old: i64 = __mind_load_i64(temp + (i + j) * 8);
            if b < 0 || b > 999 || old < 0 || old > 999 { return 0; }
            if carry < 0 || carry > 999 { return 0; }
            // At most 999*999+999+999=999999: exact in signed i64.
            let v: i64 = a * b + old + carry;
            __mind_store_i64(temp + (i + j) * 8, v % 1000);
            carry = v / 1000; j = j + 1;
        }
        // Earlier rows cannot have written index i+12.
        if __mind_load_i64(temp + (i + 12) * 8) != 0 { return 0; }
        if carry < 0 || carry > 999 { return 0; }
        __mind_store_i64(temp + (i + 12) * 8, carry); i = i + 1;
    }
    i = 12;
    while i < 24 {
        if __mind_load_i64(temp + i * 8) != 0 { return 0; }
        i = i + 1;
    }
    i = 0;
    while i < 12 {
        __mind_store_i64(out + i * 8, __mind_load_i64(temp + i * 8));
        i = i + 1;
    }
    return 1;
}
fn nd_values_equal(x: i64, y: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 12 {
        if __mind_load_i64(x + i * 8) != __mind_load_i64(y + i * 8) { return 0; }
        i = i + 1;
    }
    return 1;
}
fn nd_positive(x: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 12 {
        if __mind_load_i64(x + i * 8) != 0 { return 1; }
        i = i + 1;
    }
    return 0;
}

// Node layout: tag,a,b,minimum enclosing binders,depth (five i64 fields).
// Ground nodes are evaluated once in topological order, never by DAG expansion.
fn nd_read_terms(w: i64, count: i64) -> i64 {
    let mut i: i64 = 1;
    while i <= count {
        let tag: i64 = nd_number(w); let a: i64 = nd_number(w);
        let b: i64 = nd_number(w);
        if __mind_load_i64(w + 24) != 0 { return 0; }
        let t: i64 = nd_term(w, i); let value: i64 = nd_value(w, i);
        __mind_store_i64(t, tag); __mind_store_i64(t + 8, a);
        __mind_store_i64(t + 16, b); nd_zero(value, 12);
        let mut need: i64 = 0; let mut depth: i64 = 1;
        if tag == 1 {
            // Only unsigned numeral form is currently supported.
            if b != 0 { return 0; }
            __mind_store_i64(value, a % 1000);
            __mind_store_i64(value + 8, a / 1000);
        } else {
            if tag == 2 {
                if a > 31 || b != 0 { return 0; } need = a + 1;
            } else {
                if tag != 3 && tag != 4 { return 0; }
                if a < 1 || a >= i || b < 1 || b >= i { return 0; }
                let x: i64 = nd_term(w, a); let y: i64 = nd_term(w, b);
                need = nd_max(__mind_load_i64(x + 24), __mind_load_i64(y + 24));
                depth = 1 + nd_max(__mind_load_i64(x + 32), __mind_load_i64(y + 32));
                if depth > 32 { return 0; }
                if need == 0 {
                    if tag == 3 {
                        if nd_add(nd_value(w, a), nd_value(w, b), value) != 1 { return 0; }
                    } else {
                        if nd_multiply(w, nd_value(w, a), nd_value(w, b), value) != 1 { return 0; }
                    }
                }
            }
        }
        __mind_store_i64(t + 24, need); __mind_store_i64(t + 32, depth);
        i = i + 1;
    }
    return 1;
}
fn nd_read_formulas(w: i64, count: i64) -> i64 {
    let terms: i64 = __mind_load_i64(w + 40); let mut i: i64 = 1;
    while i <= count {
        let tag: i64 = nd_number(w); let a: i64 = nd_number(w);
        let b: i64 = nd_number(w);
        if __mind_load_i64(w + 24) != 0 { return 0; }
        let f: i64 = nd_formula(w, i);
        __mind_store_i64(f, tag); __mind_store_i64(f + 8, a);
        __mind_store_i64(f + 16, b);
        let mut need: i64 = 0; let mut depth: i64 = 1;
        if tag == 1 || tag == 2 {
            if a < 1 || a > terms { return 0; }
            need = __mind_load_i64(nd_term(w, a) + 24);
            if tag == 1 {
                if b != 0 { return 0; }
            } else {
                if b < 1 || b > terms { return 0; }
                need = nd_max(need, __mind_load_i64(nd_term(w, b) + 24));
            }
        } else {
            if tag == 3 {
                if a != 0 || b != 0 { return 0; }
            } else {
                if tag < 4 || tag > 6 { return 0; }
                if a < 1 || a >= i { return 0; }
                let child: i64 = nd_formula(w, a);
                need = __mind_load_i64(child + 24);
                depth = 1 + __mind_load_i64(child + 32);
                if tag == 6 {
                    if b != 0 { return 0; }
                    if need > 0 { need = need - 1; }
                } else {
                    if b < 1 || b >= i { return 0; }
                    let other: i64 = nd_formula(w, b);
                    need = nd_max(need, __mind_load_i64(other + 24));
                    depth = nd_max(depth, 1 + __mind_load_i64(other + 32));
                }
            }
        }
        if depth > 32 { return 0; }
        __mind_store_i64(f + 24, need); __mind_store_i64(f + 32, depth);
        i = i + 1;
    }
    return 1;
}

// Structural comparisons spend a single per-certificate work budget. There is
// intentionally no node-index equality shortcut. Shared ASTs may be adversarial.
fn nd_step(w: i64, recursion: i64) -> i64 {
    if recursion > 64 { return 0; }
    let budget: i64 = __mind_load_i64(w + 32);
    if budget <= 0 { return 0; }
    __mind_store_i64(w + 32, budget - 1); return 1;
}
fn nd_term_match(w: i64, source: i64, target: i64, substitute: i64,
                 replacement: i64, binders: i64, recursion: i64) -> i64 {
    if nd_step(w, recursion) != 1 { return 0; }
    let s: i64 = nd_term(w, source); let t: i64 = nd_term(w, target);
    let tag: i64 = __mind_load_i64(s); let a: i64 = __mind_load_i64(s + 8);
    let b: i64 = __mind_load_i64(s + 16);
    if tag == 2 && substitute == 1 {
        if a == binders {
            // Replacement is closed, so it requires no lifting under binders.
            return nd_term_match(w, replacement, target, 0, 0, 0, recursion + 1);
        }
        if __mind_load_i64(t) != 2 { return 0; }
        if a > binders {
            if __mind_load_i64(t + 8) != a - 1 { return 0; }
        } else {
            if __mind_load_i64(t + 8) != a { return 0; }
        }
        return 1;
    }
    if __mind_load_i64(t) != tag { return 0; }
    if tag == 1 || tag == 2 {
        if a != __mind_load_i64(t + 8) || b != __mind_load_i64(t + 16) { return 0; }
        return 1;
    }
    if nd_term_match(w, a, __mind_load_i64(t + 8), substitute, replacement, binders, recursion + 1) != 1 { return 0; }
    return nd_term_match(w, b, __mind_load_i64(t + 16), substitute, replacement, binders, recursion + 1);
}
fn nd_formula_match(w: i64, source: i64, target: i64, substitute: i64,
                    replacement: i64, binders: i64, recursion: i64) -> i64 {
    if nd_step(w, recursion) != 1 { return 0; }
    let s: i64 = nd_formula(w, source); let t: i64 = nd_formula(w, target);
    let tag: i64 = __mind_load_i64(s); let a: i64 = __mind_load_i64(s + 8);
    let b: i64 = __mind_load_i64(s + 16);
    if __mind_load_i64(t) != tag { return 0; }
    if tag == 3 { return 1; }
    if tag == 1 || tag == 2 {
        if nd_term_match(w, a, __mind_load_i64(t + 8), substitute, replacement, binders, recursion + 1) != 1 { return 0; }
        if tag == 1 { return 1; }
        return nd_term_match(w, b, __mind_load_i64(t + 16), substitute, replacement, binders, recursion + 1);
    }
    if tag == 6 {
        return nd_formula_match(w, a, __mind_load_i64(t + 8), substitute, replacement, binders + 1, recursion + 1);
    }
    if nd_formula_match(w, a, __mind_load_i64(t + 8), substitute, replacement, binders, recursion + 1) != 1 { return 0; }
    return nd_formula_match(w, b, __mind_load_i64(t + 16), substitute, replacement, binders, recursion + 1);
}
fn nd_same(w: i64, a: i64, b: i64) -> i64 {
    return nd_formula_match(w, a, b, 0, 0, 0, 0);
}
fn nd_premise(w: i64, prior: i64, current: i64) -> i64 {
    if prior < 1 || prior >= current { return 0; }
    let line: i64 = nd_line(w, prior);
    let active: i64 = __mind_load_i64(w + 56);
    let deps: i64 = __mind_load_i64(line + 8);
    let context: i64 = __mind_load_i64(line + 16);
    // Both dependencies and creation scope must still be active.
    if (deps & active) != deps { return 0; }
    if (context & active) != context { return 0; }
    return 1;
}

// Proof line: result formula, actual assumption dependencies, creation context,
// unique assumption bit (zero for non-assumption rules).
fn nd_read_proof(w: i64, count: i64) -> i64 {
    let mut i: i64 = 1;
    while i <= count {
        let rule: i64 = nd_number(w); let result: i64 = nd_number(w);
        let p1: i64 = nd_number(w); let p2: i64 = nd_number(w);
        let aux: i64 = nd_number(w);
        if __mind_load_i64(w + 24) != 0 { return 0; }
        if result < 1 || result > __mind_load_i64(w + 48) { return 0; }
        let f: i64 = nd_formula(w, result);
        if __mind_load_i64(f + 24) != 0 { return 0; }
        let tag: i64 = __mind_load_i64(f); let a: i64 = __mind_load_i64(f + 8);
        let b: i64 = __mind_load_i64(f + 16);
        let mut deps: i64 = 0; let mut own_bit: i64 = 0;
        if rule >= 1 && rule <= 3 {
            if p1 != 0 || p2 != 0 || aux != 0 { return 0; }
            if rule == 1 {
                let id: i64 = __mind_load_i64(w + 72);
                let depth: i64 = __mind_load_i64(w + 64);
                if id >= 30 || depth >= 30 { return 0; }
                own_bit = 1 << id; deps = own_bit;
                __mind_store_i64(w + 72, id + 1);
                __mind_store_i64(w + 63616 + depth * 8, i);
                __mind_store_i64(w + 64, depth + 1);
                __mind_store_i64(w + 56, __mind_load_i64(w + 56) | own_bit);
            } else {
                if rule == 2 {
                    if tag != 1 { return 0; }
                    // GROUND_POS recomputes the declared term, never trusts a receipt.
                    if nd_positive(nd_value(w, a)) != 1 { return 0; }
                } else {
                    if tag != 2 { return 0; }
                    // GROUND_EQ recomputes both declared terms in the AST.
                    if nd_values_equal(nd_value(w, a), nd_value(w, b)) != 1 { return 0; }
                }
            }
        } else {
            if rule < 4 || rule > 9 { return 0; }
            if nd_premise(w, p1, i) != 1 { return 0; }
            let line1: i64 = nd_line(w, p1);
            let formula1: i64 = __mind_load_i64(line1);
            let first: i64 = nd_formula(w, formula1);
            deps = __mind_load_i64(line1 + 8);
            if rule == 5 || rule == 6 || rule == 8 {
                if p2 != 0 { return 0; }
                if rule == 8 {
                    if __mind_load_i64(first) != 6 { return 0; }
                    if aux < 1 || aux > __mind_load_i64(w + 40) { return 0; }
                    if __mind_load_i64(nd_term(w, aux) + 24) != 0 { return 0; }
                    // FORALL_ELIM binds exactly the supplied closed term throughout.
                    if nd_formula_match(w, __mind_load_i64(first + 8), result, 1, aux, 0, 0) != 1 { return 0; }
                } else {
                    if aux != 0 || __mind_load_i64(first) != 4 { return 0; }
                    let mut side: i64 = __mind_load_i64(first + 8);
                    if rule == 6 { side = __mind_load_i64(first + 16); }
                    if nd_same(w, side, result) != 1 { return 0; }
                }
            } else {
                if aux != 0 || nd_premise(w, p2, i) != 1 { return 0; }
                let line2: i64 = nd_line(w, p2);
                let formula2: i64 = __mind_load_i64(line2);
                deps = deps | __mind_load_i64(line2 + 8);
                if rule == 4 {
                    if tag != 4 { return 0; }
                    if nd_same(w, a, formula1) != 1 || nd_same(w, b, formula2) != 1 { return 0; }
                } else {
                    if rule == 7 {
                        if __mind_load_i64(first) != 5 { return 0; }
                        if nd_same(w, __mind_load_i64(first + 8), formula2) != 1 { return 0; }
                        if nd_same(w, __mind_load_i64(first + 16), result) != 1 { return 0; }
                    } else {
                        // NEG_INTRO: premises are checked BEFORE closing the scope.
                        let depth: i64 = __mind_load_i64(w + 64);
                        if depth <= 0 { return 0; }
                        if __mind_load_i64(w + 63616 + (depth - 1) * 8) != p1 { return 0; }
                        let bit: i64 = __mind_load_i64(line1 + 24);
                        if bit <= 0 { return 0; }
                        if __mind_load_i64(nd_formula(w, formula2)) != 3 { return 0; }
                        if tag != 5 || __mind_load_i64(nd_formula(w, b)) != 3 { return 0; }
                        // Discharged formula must be exactly this assumption occurrence.
                        if nd_same(w, a, formula1) != 1 { return 0; }
                        deps = __mind_load_i64(line2 + 8);
                        deps = deps - (deps & bit);
                        __mind_store_i64(w + 56, __mind_load_i64(w + 56) - bit);
                        __mind_store_i64(w + 64, depth - 1);
                    }
                }
            }
        }
        let out: i64 = nd_line(w, i);
        __mind_store_i64(out, result); __mind_store_i64(out + 8, deps);
        __mind_store_i64(out + 16, __mind_load_i64(w + 56));
        __mind_store_i64(out + 24, own_bit); i = i + 1;
    }
    return 1;
}

// API preconditions: caller owns readable [p,p+n) and writable aligned
// [work,work+65536), and neither region aliases executable code or external
// mutable state. Numeric pointer checks cannot establish allocation ownership.
// Returns 1 only for a closed derivation of the caller-declared goal.
pub fn finite_nd_check(p: i64, n: i64, work: i64, cap: i64) -> i64 {
    if p <= 0 || work <= 0 || n <= 0 || n > 65536 || cap < 65536 { return 0; }
    if work % 8 != 0 { return 0; }
    if p > 9223372036854775807 - n || work > 9223372036854775807 - 65536 { return 0; }
    if p < work + 65536 && work < p + n { return 0; }
    nd_zero(work, 8192);
    __mind_store_i64(work, p); __mind_store_i64(work + 8, n);
    __mind_store_i64(work + 32, 200000);
    if nd_number(work) != 74123 || nd_number(work) != 1 { return 0; }
    let terms: i64 = nd_number(work);
    if terms < 1 || terms > 256 { return 0; }
    __mind_store_i64(work + 40, terms);
    if nd_read_terms(work, terms) != 1 { return 0; }
    let formulas: i64 = nd_number(work);
    if formulas < 1 || formulas > 512 { return 0; }
    __mind_store_i64(work + 48, formulas);
    if nd_read_formulas(work, formulas) != 1 { return 0; }
    let goal: i64 = nd_number(work);
    if goal < 1 || goal > formulas { return 0; }
    if __mind_load_i64(nd_formula(work, goal) + 24) != 0 { return 0; }
    let proof: i64 = nd_number(work);
    if proof < 1 || proof > 256 { return 0; }
    if nd_read_proof(work, proof) != 1 { return 0; }
    if __mind_load_i64(work + 24) != 0 { return 0; }
    // Exact end-of-input is a security boundary, not whitespace normalization.
    if __mind_load_i64(work + 16) != n { return 0; }
    if __mind_load_i64(work + 56) != 0 || __mind_load_i64(work + 64) != 0 { return 0; }
    let last: i64 = nd_line(work, proof);
    if __mind_load_i64(last + 8) != 0 { return 0; }
    if nd_same(work, __mind_load_i64(last), goal) != 1 { return 0; }
    return 1;
}
