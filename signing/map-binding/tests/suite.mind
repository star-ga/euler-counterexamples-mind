    if gn != 419 || ended != 1 { return 2; }
    t_expected(e, 48);
    if t_record(totals, 46, 0, pqc_binding_check(genuine, gn, e, 65, w, 16)) != 1 { return 2; }
    n = t_build(p, meta, 48, 0);
    let mut cut: i64 = 0; let mut cut_failures: i64 = 0; let mut cut_count: i64 = 0;
    while cut <= 419 {
        if pqc_binding_check(p, cut, e, 65, w, 16) != 0 { cut_failures = cut_failures + 1; }
        cut_count = cut_count + 1; cut = cut + 1;
    }
    let mut i: i64 = 8;
    while i < 13 {
        if i != 10 {
            let start: i64 = __mind_load_i64(meta + i * 64 + 32);
            let size: i64 = __mind_load_i64(meta + i * 64 + 40);
            if pqc_binding_check(p, start, e, 65, w, 16) != 0 { cut_failures = cut_failures + 1; }
            if pqc_binding_check(p, start + size / 2, e, 65, w, 16) != 0 { cut_failures = cut_failures + 1; }
            cut_count = cut_count + 2;
            if start + size < n {
                if pqc_binding_check(p, start + size, e, 65, w, 16) != 0 { cut_failures = cut_failures + 1; }
                cut_count = cut_count + 1;
            }
        }
        i = i + 1;
    }
    if t_emit("PREFIX_CHECKS=") != 1 { return 2; } print(cut_count);
    if t_emit("PREFIX_FAILURES=") != 1 { return 2; } print(cut_failures);
    __mind_store_i64(totals, __mind_load_i64(totals) + cut_failures);
    __mind_store_i64(totals + 16, __mind_load_i64(totals + 16) + cut_count);
    if t_record(totals, 104, 1, pqc_binding_check(p, n, e, 65, w, 16)) != 1 { return 2; }
    if t_emit("EXPECTED_ACCEPTS=") != 1 { return 2; } print(__mind_load_i64(totals + 8));
    if t_emit("EXPECTED_REJECTIONS=") != 1 { return 2; } print(__mind_load_i64(totals + 16));
    if t_emit("UNEXPECTED_RESULTS=") != 1 { return 2; } print(__mind_load_i64(totals));
    if __mind_load_i64(totals) != 0 { if t_emit("MAP_BINDING_SUITE=FAIL\n") != 1 { return 2; } return 1; }
    if t_emit("MAP_BINDING_SUITE=PASS\n") != 1 { return 2; } return 0;
}
